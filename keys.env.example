# Al-Jin optional API keys. ALL OPTIONAL: the bot works without any.
# Copy this file to keys.env and fill only what you need.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
BRIA_API_KEY=
HF_TOKEN=
IG_SESSIONID=

# --- Plugins added in v2.3.0 (all optional) ---
# .tg  Telegram sticker packs: free token from @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
# .remini  your own key for the online enhancer (a shared one is built in; the offline enhancer is the fallback)
PRINCE_API_KEY=
# .tdl  Telegram downloader: chat ids to index for search (comma separated), and an optional path to the tdl program
TDL_CHATS=
TDL_PATH=
