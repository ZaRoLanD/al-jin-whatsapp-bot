legacy-peer-deps=true
fund=false
audit=false
omit=optional
@jsr:registry=https://npm.jsr.io
# npm 12 blocks "remote" tarballs by default. @postfetch/core comes from npm.jsr.io as a tarball,
# so allow it (every download is still checked against the integrity hash in package-lock.json).
allow-remote=all
